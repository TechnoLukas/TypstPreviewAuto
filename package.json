{
  "name": "typst-preview-auto",
  "displayName": "Typst Preview Auto",
  "description": "Automatically pins the active Typst file in Preview when it becomes active in the editor.",
  "version": "0.0.4",
  "publisher": "technolukas",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "typst",
    "preview",
    "tinymist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechnoLukas/TypstAutoPreview.git"
  },
  "homepage": "https://github.com/TechnoLukas/TypstAutoPreview",
  "bugs": {
    "url": "https://github.com/TechnoLukas/TypstAutoPreview/issues"
  },
  "activationEvents": [
    "onLanguage:typst"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.5.4"
  }
}